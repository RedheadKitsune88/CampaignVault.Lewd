<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>GoblinPonyriders</RootNamespace>
    <AssemblyName>GoblinPonyriders</AssemblyName>
    <Version>0.2.0</Version>
    <Description>CampaignVault.Goblins — optional Goblin Ponyriders / Unified Clans high-stakes faction overlay (adult content; builds on LewdHandbook events).</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GoblinPonyriders.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Compile against Sdk; do not copy CampaignVault.PluginSdk.dll into the plugin drop. -->
    <PackageReference Include="CampaignVault.PluginSdk" Version="0.15.0">
      <ExcludeAssets>runtime</ExcludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <None Update="plugin.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="RulesetData\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="skills\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
