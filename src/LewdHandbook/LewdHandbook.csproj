<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>LewdHandbook</RootNamespace>
    <AssemblyName>LewdHandbook</AssemblyName>
    <Version>0.1.0</Version>
    <Description>Opt-in lewd_encounter interaction mode plugin for CampaignVault (adult content).</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LewdHandbook.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Compile against Sdk; do not copy CampaignVault.PluginSdk.dll into the plugin drop. -->
    <PackageReference Include="CampaignVault.PluginSdk" Version="0.1.1">
      <ExcludeAssets>runtime</ExcludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <None Update="plugin.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="RulesetData\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="skills\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
