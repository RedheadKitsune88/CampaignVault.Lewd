<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- Local packs from ../CampaignVault/scripts/pack-pluginsdk.sh (e.g. 0.12.0 before nuget.org). -->
    <add key="campaignvault-local" value="../CampaignVault/nupkgs" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
